# ==============================================================================
# Smart Attendance Backend Server Configuration Template (.env.example)
# Copy this file to .env and configure values appropriate for your environment.
# Never commit real credentials or secrets to version control.
# ==============================================================================

# Application Environment
# Options: development | production | test
NODE_ENV=development

# HTTP Server Port (1 - 65535)
PORT=3000

# PostgreSQL Database Connection String
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# In production, specify valid credentials and non-loopback host.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smart_attendance

# Set to true only if running production server against a local database (e.g. single-box staging)
ALLOW_LOCAL_DATABASE_IN_PROD=false

# JSON Web Token Secret
# In production, MUST be at least 32 cryptographically random characters.
# Generate with: openssl rand -base64 32
JWT_SECRET=development_only_secret_must_be_changed_in_prod_32chars!

# Cross-Origin Resource Sharing (CORS) Allowed Origins
# In production, must be an explicit comma-separated list of approved web origins (no wildcards).
# Example: https://admin.smartattendance.ac.in,https://attendance.smartattendance.ac.in
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Institutional Email Domain
# Used for institutional email validation and user assignment.
COLLEGE_EMAIL_DOMAIN=sonatech.ac.in

# Timetable Early Session Start Window (in minutes)
# Defines how early a faculty member can open an attendance session prior to period start.
ATTENDANCE_START_EARLY_MINUTES=20

# Authentication Rate Limiting
# Maximum requests allowed per IP address within the sliding window for public auth endpoints.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Demo Signup Controls (strictly disabled in production)
ENABLE_DEMO_SIGNUP=false

# ==============================================================================
# Face Detection and Identity Matching Engine (Milestone F5 & F6)
# ==============================================================================

# Face Matching Provider Strategy
# Options:
#   - NOT_CONFIGURED: Safe non-operational stub (reports honest unconfigured state)
#   - OPENCV_SFACE: Real OpenCV YuNet detection + SFace 128-d cosine embedding engine
FACE_MATCHING_PROVIDER=NOT_CONFIGURED

# Cosine Similarity Threshold (0.00 to 1.00)
# Minimum cosine similarity between reference embedding and probe embedding to match identity.
# SFace default recommended threshold: 0.363 - 0.400
FACE_MATCH_THRESHOLD=0.40

# Face Detector Confidence Cutoff (0.00 to 1.00)
# Minimum YuNet detection score required to process a face.
FACE_MIN_CONFIDENCE=0.60

# Python Executable / Virtualenv Path for infer.py engine runner
# Path to python3 binary with cv2 and numpy installed.
PYTHON_PATH=python
